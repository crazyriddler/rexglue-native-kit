# Kit configuration. Sourced by bench/*.sh, tools/*.sh and scripts/dev_env.sh,
# read by tools/kitcfg.py. Fill it in during bootstrap (docs/NATIVE_PORT_PLAYBOOK.md,
# phase 0) and keep it current: every script depends on it.

# Project/executable name chosen at `rexglue init` (the exe is $GAME_NAME.exe).
GAME_NAME=game
# rexglue project folder, relative to the kit root (created by `rexglue init`).
PORT_DIR=port
# Title ID, 8 hex digits (XEX header / "Initializing shader storage for title ..." log line).
TITLE_ID=
# The game's output (front buffer) resolution. Most 360 titles: 1280x720.
GUEST_WIDTH=1280
GUEST_HEIGHT=720

# Toolchain paths (docs/TOOLCHAIN_SETUP.md). No admin rights, no Visual Studio:
# portable LLVM + xwin CRT/SDK + pip ninja. The values below are the kit author's PC:
# change them to where the tools are installed on this PC.
LLVM_DIR=/c/Users/jrbar/tools/clang+llvm-23.1.1-x86_64-pc-windows-msvc
XWIN_SYSROOT=/c/Users/jrbar/tools/xwin_sysroot
NINJA_DIR=/c/Users/jrbar/AppData/Roaming/Python/Python314/Scripts
# Visual C++ runtime DLLs copied app-local into the release folder.
VC_REDIST_GLOB="/c/Program Files/Microsoft Visual Studio/2022/*/VC/Redist/MSVC/*/x64/Microsoft.VC143.CRT"

# Build directories under $PORT_DIR/out/build.
# BUILD_DEV: RelWithDebInfo (logs, symbols, profiling, A/B with the Xenos plugin).
# BUILD_REL: Release (benchmarks, release folder).
BUILD_DEV=nr
BUILD_REL=nr-rel

# Flags bench/run.sh adds unless the caller passes them (a flag given twice makes
# the SDK command-line parser drop EVERY flag). Start empty: an unknown cvar is an
# error. Once the native renderer and the launcher exist, use the reproducible set
# (original-quality, no launcher, unlocked):
# BENCH_DEFAULTS="show_launcher=false render_scale=1 shadow_quality=1 anisotropic_filtering=-1 msaa_samples=0 fps_limit=0 vsync=false full_scene_resolution=false foliage_antialiasing=false fxaa=false ambient_occlusion=false bloom_quality=1 present_dither=false shadow_smoothing=0 soft_particles=false smooth_effects=false"
BENCH_DEFAULTS=""
